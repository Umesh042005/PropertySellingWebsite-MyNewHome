# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in.

# Port the app is published on: http://localhost:3000
APP_PORT=3000
# Public URL people use to open the site (used for CORS)
PUBLIC_URL=http://localhost:3000

# MySQL (the database container is created with these)
DB_USERNAME=mynewhome
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Required. At least 32 random characters: openssl rand -base64 48
JWT_SECRET=

# Optional features
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
