# Copy to .env (git-ignored) for local development. In production set these as environment variables.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/propertydb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Required. At least 32 random characters, e.g. output of: openssl rand -base64 48
JWT_SECRET=

# Allowed frontend origin(s), comma separated
FRONTEND_URL=http://localhost:3000

# Optional: Google sign-in (OAuth "Web application" client id). Empty = disabled
GOOGLE_CLIENT_ID=

# Optional: Gemini API key for "Write it with AI". Empty = disabled
GEMINI_API_KEY=
