# Copy to .env.production.local (or set in your hosting dashboard) before "npm run build".

# Backend base URL. Leave empty when the frontend is served behind the nginx proxy (docker-compose),
# set it when frontend and backend are hosted separately, e.g. https://mynewhome-api.onrender.com
REACT_APP_API_URL=

# Google OAuth Web client id. Leave empty to hide "Sign in with Google".
REACT_APP_GOOGLE_CLIENT_ID=
